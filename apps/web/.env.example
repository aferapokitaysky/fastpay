# Public API base URL. Never include credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Required outside local demo mode for waiter PIN login.
# Obtain the UUID from the seeded/staging venue, never from a QR token.
NEXT_PUBLIC_STAFF_VENUE_ID=

# B3 realtime endpoint. Leave empty until the authenticated WS gateway is deployed.
NEXT_PUBLIC_STAFF_WS_URL=
